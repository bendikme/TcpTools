// TcpTools resources: application icon + version information
#include <winver.h>
#include "Version.h"

// Application icon (first icon in the file = the exe's icon in Explorer)
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    TCPTOOLS_VERSION_RC
 PRODUCTVERSION TCPTOOLS_VERSION_RC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Bendik Eide"
            VALUE "FileDescription",  "TcpTools - TCP/UDP client, server and relay"
            VALUE "FileVersion",      TCPTOOLS_VERSION_STR
            VALUE "InternalName",     "TcpTools"
            VALUE "LegalCopyright",   TCPTOOLS_COPYRIGHT_RC
            VALUE "OriginalFilename", "TcpTools.exe"
            VALUE "ProductName",      "TcpTools"
            VALUE "ProductVersion",   TCPTOOLS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
